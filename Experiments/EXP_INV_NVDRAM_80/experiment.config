[DEFAULT]
label =

# ─────────────────────────────────────────────────────────────────────────────
# Material thermal properties for the BASELINE hybrid NVDRAM-bottom / DRAM-top
# stack (paper's "3D thermal penalty" conditions). Identical to EXP_NVDRAM_S
# except the two stacks on each short edge are separated by an equivalent-k MOLD
# gap (unmerged baseline; central column stays THERMAL_SI as in the paper), and
# the generator applies a non-uniform hotspot GPU power map.
# Convention: thermalresistivity ((m-k)/w) = 1 / k(W/m-K).  Steady-state depends
# only on thermalresistivity (cross-plane / vertical k from the paper table).
# ─────────────────────────────────────────────────────────────────────────────

[BSPDN]
# anisotropic per the paper: in-plane k = 83, cross-plane 71
# GPU backside power-delivery network (bottom, package side).  k = 71 W/(m-K)
thermalresistivity ((m-k)/w) = 0.014085
specificheatcapacity (j/m^3k) = 1750000
inplanethermalresistivity ((m-k)/w) = 0.012048

[GPU_FEOL]
# GPU front-end active silicon (the 414 W heat source).  k = 7.9 W/(m-K)
thermalresistivity ((m-k)/w) = 0.126582
specificheatcapacity (j/m^3k) = 1700000

[BEOL_MXY]
# GPU front-side Cu / low-k metal stack.  k = 1.5 W/(m-K)
thermalresistivity ((m-k)/w) = 0.666667
specificheatcapacity (j/m^3k) = 2400000

[OXIDE]
# Bonding / passivation oxide.  k = 1.5 W/(m-K)
thermalresistivity ((m-k)/w) = 0.666667
specificheatcapacity (j/m^3k) = 1660000

[GPU_HBM_UBUMP]
# anisotropic per the paper: in-plane k = 0.59 (solder/underfill), cross 19.28
# GPU<->HBM microbump / hybrid-bond interface.  k_cross = 19.28 W/(m-K)
thermalresistivity ((m-k)/w) = 0.051867
specificheatcapacity (j/m^3k) = 2500000
inplanethermalresistivity ((m-k)/w) = 1.694915

[HBM_BASE_SI]
# HBM base-die silicon substrate.  k = 140 W/(m-K)
thermalresistivity ((m-k)/w) = 0.007143
specificheatcapacity (j/m^3k) = 1750000

[HBM_BASE_BEOL]
# HBM base-die BEOL.  k = 1.5 W/(m-K)
thermalresistivity ((m-k)/w) = 0.666667
specificheatcapacity (j/m^3k) = 2400000

[HYBRID_BOND]
# Cu/oxide hybrid bond between stacked dies.  k = 4.8 W/(m-K)
thermalresistivity ((m-k)/w) = 0.208333
specificheatcapacity (j/m^3k) = 2000000

[NV_DIE_SI]
# NVDRAM die silicon substrate.  CANONICAL: k = 140 W/(m-K), EQUAL to the DRAM
# die -- the technologies then differ only in power. Lower this (e.g. 0.07 ->
# k~14) to model a low-thermal-conductivity ferroelectric NVDRAM die.
thermalresistivity ((m-k)/w) = 0.007143
specificheatcapacity (j/m^3k) = 1500000

[NV_DIE_BEOL]
# NVDRAM die BEOL (low-k interconnect).  k = 0.85 W/(m-K)
thermalresistivity ((m-k)/w) = 1.176471
specificheatcapacity (j/m^3k) = 2200000

[DRAM_BEOL]
# DRAM die BEOL (low-k interconnect).  k = 0.85 W/(m-K) -- a key vertical
# resistance inside the memory stack.
thermalresistivity ((m-k)/w) = 1.176471
specificheatcapacity (j/m^3k) = 2200000

[DRAM_SI]
# DRAM die silicon substrate (inner 50 um / top 169 um).  k = 140 W/(m-K)
thermalresistivity ((m-k)/w) = 0.007143
specificheatcapacity (j/m^3k) = 1750000

[MOLD]
# BASELINE inter-stack gap between the two memory stacks on each short edge.
# Physically the paper's gap is ~0.1 mm of k = 3 W/(m-K) mold compound; the
# 0.5 mm grid cannot resolve 0.1 mm, so the generator draws the gap 1.0 mm wide
# and k is scaled x10 (k_eff = 30 W/(m-K), thermalresistivity 1/30 = 0.033333)
# to preserve the same LATERAL thermal resistance across the gap. "HBM stack
# merging" (EXP_NVDRAM_S / --merged) removes this gap entirely.
thermalresistivity ((m-k)/w) = 0.033333
specificheatcapacity (j/m^3k) = 1500000

[THERMAL_SI]
# High-k "thermal silicon" central column (k=140) between the stack pairs.
# Part of the paper's BASELINE already ("thermal silicon fills the central
# void"); the baseline penalty comes from the unmerged stacks + real power map.
thermalresistivity ((m-k)/w) = 0.007143
specificheatcapacity (j/m^3k) = 1750000

[TIM]
# Thermal interface material between the top die and the lid.  k = 9.71 W/(m-K)
thermalresistivity ((m-k)/w) = 0.102987
specificheatcapacity (j/m^3k) = 2000000

[LID]
# Integrated heat-spreader / cold-plate lid (Cu).  k = 400 W/(m-K)
thermalresistivity ((m-k)/w) = 0.0025
specificheatcapacity (j/m^3k) = 3500000


[PKG_MOLD]
# Package mold surround: 6 mm ring of epoxy mold compound around the die (the
# paper's package extends well beyond the die). k = 3 W/(m-K), as in the paper.
# Gives heat a lateral path around the die and softens the die-edge gradients.
thermalresistivity ((m-k)/w) = 0.333333
specificheatcapacity (j/m^3k) = 1500000

[Init]
# Paper ambient = 20 C = 293.15 K.
ambient = 293.15 K
temperature = 293.15 K

# ─────────────────────────────────────────────────────────────────────────────
# Top-side cooling = liquid cold plate. Pure convective (HTC) boundary applied on
# top of the explicit Lid layer: r_amb = 1/(htc*cell_area). Paper lid HTC =
# 30,000 W/m^2K. Bottom (BSPDN/package) is adiabatic.
# ─────────────────────────────────────────────────────────────────────────────
[NoPackage]
htc = 30000
thickness (m) = 1e-6
thermalresistivity ((m-k)/w) = 0.0025
specificheatcapacity (j/m^3k) = 3500000
