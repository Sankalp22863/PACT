[DEFAULT]
label =

# ─────────────────────────────────────────────────────────────────────────────
# Material thermal properties for the BASELINE hybrid NVDRAM-bottom / DRAM-top
# stack (paper's "3D thermal penalty" case). Identical to EXP_NVDRAM_S except the
# cross/frame between and around the memory stacks is MOLD (epoxy mold compound,
# k≈0.8) instead of the high-k THERMAL_SI (k=140) escape path -> reproduces the
# un-optimized baseline.
# Convention: thermalresistivity ((m-k)/w) = 1 / k(W/m-K).  Steady-state depends
# only on thermalresistivity (cross-plane / vertical k from the paper table).
# ─────────────────────────────────────────────────────────────────────────────

[BSPDN]
# GPU backside power-delivery network (bottom, package side).  k = 71 W/(m-K)
thermalresistivity ((m-k)/w) = 0.014085
specificheatcapacity (j/m^3k) = 1750000

[GPU_FEOL]
# GPU front-end active silicon (the 414 W heat source).  k = 7.9 W/(m-K)
thermalresistivity ((m-k)/w) = 0.126582
specificheatcapacity (j/m^3k) = 1700000

[GPU_SI]
# GPU bulk silicon substrate (thinned die for 3D/BSPDN). Bulk Si k = 130 W/(m-K).
# This thick, high-conductivity layer gives the GPU LATERAL heat spreading so heat
# can flow sideways into the central/merged silicon -- the mechanism behind the
# paper's HBM-stack-merging benefit (imec Fig. 7: ~7% of peripheral GPU power flows
# inward to the central silicon). Without it, the thin 0.15 um FEOL cannot spread
# heat and stack merging barely moves the peak.
thermalresistivity ((m-k)/w) = 0.007692
specificheatcapacity (j/m^3k) = 1750000

[BEOL_MXY]
# GPU front-side Cu / low-k metal stack.  k = 1.5 W/(m-K)
thermalresistivity ((m-k)/w) = 0.666667
specificheatcapacity (j/m^3k) = 2400000

[OXIDE]
# Bonding / passivation oxide.  k = 1.5 W/(m-K)
thermalresistivity ((m-k)/w) = 0.666667
specificheatcapacity (j/m^3k) = 1660000

[GPU_HBM_UBUMP]
# GPU<->HBM microbump / hybrid-bond interface.  k_cross = 19.28 W/(m-K)
thermalresistivity ((m-k)/w) = 0.051867
specificheatcapacity (j/m^3k) = 2500000

[HBM_BASE_SI]
# HBM base-die silicon substrate.  k = 140 W/(m-K)
thermalresistivity ((m-k)/w) = 0.007143
specificheatcapacity (j/m^3k) = 1750000

[HBM_BASE_BEOL]
# HBM base-die BEOL.  k = 1.5 W/(m-K)
thermalresistivity ((m-k)/w) = 0.666667
specificheatcapacity (j/m^3k) = 2400000

[HYBRID_BOND]
# Cu/oxide hybrid bond between stacked dies.  k = 4.8 W/(m-K)
thermalresistivity ((m-k)/w) = 0.208333
specificheatcapacity (j/m^3k) = 2000000

[NV_DIE_SI]
# NVDRAM die silicon substrate.  CANONICAL: k = 140 W/(m-K), EQUAL to the DRAM
# die -- the technologies then differ only in power. Lower this (e.g. 0.07 ->
# k~14) to model a low-thermal-conductivity ferroelectric NVDRAM die.
thermalresistivity ((m-k)/w) = 0.007143
specificheatcapacity (j/m^3k) = 1500000

[NV_DIE_BEOL]
# NVDRAM die BEOL (low-k interconnect).  k = 0.85 W/(m-K)
thermalresistivity ((m-k)/w) = 1.176471
specificheatcapacity (j/m^3k) = 2200000

[DRAM_BEOL]
# DRAM die BEOL (low-k interconnect).  k = 0.85 W/(m-K) -- a key vertical
# resistance inside the memory stack.
thermalresistivity ((m-k)/w) = 1.176471
specificheatcapacity (j/m^3k) = 2200000

[DRAM_SI]
# DRAM die silicon substrate (inner 50 um / top 169 um).  k = 140 W/(m-K)
thermalresistivity ((m-k)/w) = 0.007143
specificheatcapacity (j/m^3k) = 1750000

[MOLD]
# BASELINE cross/frame filler: mold compound between/around the memory stacks.
# k = 3 W/(m-K) -- the value used by the imec IEDM 2025 paper (Chen et al.,
# "Breaking Thermal Bottleneck in 3D HBM-on-GPU Integration via STCO", Sec II.A:
# "mold compound (3 W/mK) fills the cavities" / "fills the remaining gaps between
# structures"). -> thermalresistivity = 1/3 = 0.333333. Still a low-conductivity
# vertical path vs the THERMAL_SI (k=140) escape column; replaced by THERMAL_SI
# at the thermal-silicon-optimization step.
thermalresistivity ((m-k)/w) = 0.333333
specificheatcapacity (j/m^3k) = 1500000

[THERMAL_SI]
# High-k "thermal silicon" filler (k=140). NOT used in the baseline; kept so the
# generator's --optimized mode (= EXP_NVDRAM_S) still resolves. k = 140 W/(m-K)
thermalresistivity ((m-k)/w) = 0.007143
specificheatcapacity (j/m^3k) = 1750000

[MERGE_SI]
# Continuous silicon bridge that replaces the inter-stack mold when stacks are
# merged (imec paper: "replacing the mold compound between them with a continuous
# silicon region"). Solid Si, k = 140 W/(m-K) in-plane and cross-plane (paper
# Fig. 3 caption). Same conductivity as THERMAL_SI; a distinct label so the
# merging and thermal-silicon interventions stay traceable in the floorplans.
thermalresistivity ((m-k)/w) = 0.007143
specificheatcapacity (j/m^3k) = 1750000

[TIM]
# Thermal interface material between the top die and the lid.  k = 9.71 W/(m-K)
thermalresistivity ((m-k)/w) = 0.102987
specificheatcapacity (j/m^3k) = 2000000

[LID]
# Integrated heat-spreader / cold-plate lid (Cu).  k = 400 W/(m-K)
thermalresistivity ((m-k)/w) = 0.0025
specificheatcapacity (j/m^3k) = 3500000

[Init]
# Paper ambient = 20 C = 293.15 K.
ambient = 293.15 K
temperature = 293.15 K

# ─────────────────────────────────────────────────────────────────────────────
# Top-side cooling = liquid cold plate. Pure convective (HTC) boundary applied on
# top of the explicit Lid layer: r_amb = 1/(htc*cell_area). Bottom (BSPDN/package)
# is adiabatic.
#
# CALIBRATION (path-3 faithful-geometry model): the paper's Fig. 3 layout (two HBM
# stack columns on the short edges + a central mold void). THREE knobs are set so
# the all-DRAM STCO staircase matches the reference (Chen et al., IEDM 2025) across
# ALL tiers (each within ~2 C):
#   * GPU_SI substrate = 1500 um   (run_waterfall.py --gpu-si-um; lateral spreading)
#   * merge-void width = 5000 um   (run_waterfall.py --void-um; sets the merge step to ~-17 C)
#   * lid htc (below)  = 35,000 W/m^2K  (anchors the baseline to ~142 C)
# These absorb what a uniform-power compact model cannot reproduce from the paper's
# Ansys-Icepak 3D solve + non-uniform 0.5 mm power maps (which set where hotspots
# form). Result vs reference: 142.8/139.4/122.7/120.9/98.7/86.3 C
#                             (141.7/138.0/120.4/120.0/99.2/87.4 C).
# ─────────────────────────────────────────────────────────────────────────────
[NoPackage]
htc = 35000
thickness (m) = 1e-6
thermalresistivity ((m-k)/w) = 0.0025
specificheatcapacity (j/m^3k) = 3500000
