[DEFAULT]
label =

# ─────────────────────────────────────────────────────────────────────────────
# Material thermal properties for the GPU + NVDRAM 3D stack.
# Convention: thermalresistivity ((m-k)/w) = 1 / k(W/m-K).
# ─────────────────────────────────────────────────────────────────────────────

[GPU_Si]
# GPU substrate / bulk silicon with through-silicon vias (TSVs).
# k = 130 W/(m-K) -> 1/130 = 0.0077
thermalresistivity ((m-k)/w) = 0.0077
specificheatcapacity (j/m^3k) = 1750000

[GPU_FEOL]
# GPU front-end-of-line: active silicon transistors (the dominant heat source).
# Doped/patterned active Si, k ~ 110 W/(m-K) -> 1/110 = 0.0091
thermalresistivity ((m-k)/w) = 0.0091
specificheatcapacity (j/m^3k) = 1700000

[GPU_BEOL]
# GPU back-end-of-line: Cu / low-k dielectric interconnect stack.
# Effective k ~ 12 W/(m-K) (low-k dielectric dominates vertical conduction) -> 1/12 = 0.083
thermalresistivity ((m-k)/w) = 0.083
specificheatcapacity (j/m^3k) = 2400000

[HB_uBump]
# Hybrid-bond / Cu-Cu microbump 3D interface + underfill.
# Effective k ~ 20 W/(m-K) -> 1/20 = 0.05
thermalresistivity ((m-k)/w) = 0.05
specificheatcapacity (j/m^3k) = 2500000

[FILLER]
# Dielectric / underfill filler material surrounding the memory macro
# (imec memory-on-logic). Low-k oxide, thermally insulating.
# k ~ 1.4 W/(m-K) -> 1/1.4 = 0.714
thermalresistivity ((m-k)/w) = 0.714
specificheatcapacity (j/m^3k) = 1660000

[NV_FEOL]
# NVDRAM front-end-of-line: poly-Si 1T1C access transistor + HZO ferroelectric cap.
# k_eff ~ 14 W/(m-K) (LPCVD poly-Si grain-boundary scattering) -> 1/14 = 0.07
thermalresistivity ((m-k)/w) = 0.07
specificheatcapacity (j/m^3k) = 1500000

[NV_BEOL]
# NVDRAM back-end-of-line: local word/bit-line Cu interconnect.
# Effective k ~ 12 W/(m-K) -> 1/12 = 0.083
thermalresistivity ((m-k)/w) = 0.083
specificheatcapacity (j/m^3k) = 2200000

[Init]
ambient = 318.15 K
temperature = 273.15 K

[HeatSink]
# Medium-cost heat sink (HotSpot model). Heatspreader (20mm) > 17mm die; heatsink 40mm.
convection_cap (j/k) = 140.4
convection_r (k/w) = 0.1
heatsink_side (m) = 0.04
heatsink_thickness (m) = 0.001
heatsink_thermalconductivity (w/(m-k)) = 400.0
heatsink_specificheatcapacity (j/m^3k) = 3.55e6
heatspreader_side (m) = 0.02
heatspreader_thickness (m) = 0.001
heatspreader_thermalconductivity (w/(m-k)) = 400.0
heatspreader_specificheatcapacity (j/m^3k) = 3.55e6
