[DEFAULT]
label =

[Path]

[Simulation]
steady_state = True
steady_state_solver = Solver
transient = True
# 3 ptrace steps x 333ms = 999ms active, total 1332ms
step_size = 3.33ms
total_simulation_time = 1332ms
ptrace_step_size = 333ms
temperature_dependent = False
convergence = 0.1
layer = 1
temperature_dependent_library = TemperatureDependent.py
# Serial Xyce only - set to 1
number_of_core = 1
init_file = False

[Solver]
name = SPICE_transient
wrapper = SPICESolver_transient.py
# Steady-state only (no Xyce required) - uncomment these and comment the two lines above:
#name = SuperLU
#wrapper = SuperLUSolver.py
ll_steady_solver = KLU
ll_transient_solver = TRAP

[Grid]
grid_mode = max
type = Uniform
granularity = Grid
# 17mm die / 40 = 0.425mm per cell; the 8.5mm memory macro = 20x20 cells (offset 10).
rows = 40
cols = 40

#DO NOT CHANGE BELOW
[VirtualNodes]
center_center = 0.5
bottom_center = 1

[HeatSink]
LateralHeatFlow = True
VerticalHeatFlow = True
library_name = HeatSink_sec
library = HeatSink.py
virtual_node = bottom_center
transient = True
mode = single

[HeatSink_sec]
properties = convection_cap (j/k), convection_r (k/w), heatsink_side (m), heatsink_thickness (m), heatsink_thermalconductivity (w/(m-k)), heatsink_specificheatcapacity (j/m^3k), heatspreader_side (m), heatspreader_thickness (m), heatspreader_thermalconductivity (w/(m-k)), heatspreader_specificheatcapacity (j/m^3k)

[GPU_Si]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[GPU_FEOL]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[GPU_BEOL]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[HB_uBump]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[FILLER]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[NV_FEOL]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[NV_BEOL]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[Solid]
properties = thermalresistivity ((m-k)/w), specificheatcapacity (j/m^3k)
