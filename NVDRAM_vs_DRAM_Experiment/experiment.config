[DEFAULT]
label =

[Si]
# Bulk silicon — used for CMOS under-array and DRAM bulk die
# k = 130 W/(m·K)
thermalresistivity ((m-k)/w) = 0.0077
specificheatcapacity (j/m^3k) = 1750000

[PolySi1T1C]
# NVDRAM: poly-Si access transistor + HZO ferroelectric capacitor
# k_eff ~ 14 W/(m·K) — grain-boundary scattering in LPCVD poly-Si dominates
# Specific heat: weighted average of poly-Si (~1.63e6) and HZO/SiO2 (~1.6e6)
thermalresistivity ((m-k)/w) = 0.07
specificheatcapacity (j/m^3k) = 1500000

[FusionBond]
# SiO2-SiO2 direct fusion bonding interface for wafer-bonded 3D DRAM
# k ~ 1.4 W/(m·K) — low-k oxide dominates at the interface
# Creates a significant thermal resistance barrier absent in monolithic NVDRAM
thermalresistivity ((m-k)/w) = 0.714
specificheatcapacity (j/m^3k) = 1660000

[Init]
ambient = 318.15 K
temperature = 273.15 K

[HeatSink]
# Medium-cost heat sink — same package for both chips (8.5mm x 8.5mm die)
convection_cap (j/k) = 140.4
convection_r (k/w) = 0.1
heatsink_side (m) = 0.04
heatsink_thickness (m) = 0.001
heatsink_thermalconductivity (w/(m-k)) = 400.0
heatsink_specificheatcapacity (j/m^3k) = 3.55e6
heatspreader_side (m) = 0.02
heatspreader_thickness (m) = 0.001
heatspreader_thermalconductivity (w/(m-k)) = 400.0
heatspreader_specificheatcapacity (j/m^3k) = 3.55e6
