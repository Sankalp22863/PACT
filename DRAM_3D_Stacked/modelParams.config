[DEFAULT]
label =

[Path]

[Simulation]
# Steady-state only: we want the peak GPU temperature to compare against the
# paper. SuperLU needs no SPICE engine; SPICE_steady uses Xyce (set below).
steady_state = True
steady_state_solver = Solver
transient = False
step_size = 3.33ms
total_simulation_time = 3.33ms
ptrace_step_size = 3.33ms
temperature_dependent = False
convergence = 0.1
layer = 1
temperature_dependent_library = TemperatureDependent.py
number_of_core = 1
init_file = False

[Solver]
# Default: SuperLU steady solver (pure Python/scipy, no Xyce needed -> fast).
name = SuperLU
wrapper = SuperLUSolver.py
# To use the Xyce SPICE steady solver instead, comment the two lines above and
# uncomment the two below:
#name = SPICE_steady
#wrapper = SPICESolver_steady.py
ll_steady_solver = KLU
ll_transient_solver = TRAP

[Grid]
grid_mode = max
type = Uniform
granularity = Grid
# 24 mm die / 48 = 0.5 mm per cell; 10 mm HBM stack = 20 cells.
rows = 48
cols = 48

#DO NOT CHANGE BELOW
[VirtualNodes]
center_center = 0.5
bottom_center = 1

# Top-side convective lid (pure HTC boundary). VerticalHeatFlow=False ->
# r_amb = 1/(htc*cell_area) with no extra series conduction.
[NoPackage]
LateralHeatFlow = True
VerticalHeatFlow = False
library_name = NoPackage_sec
library = Solid.py
virtual_node = bottom_center
transient = True
mode = single

[NoPackage_sec]
properties = htc, thickness (m), thermalresistivity ((m-k)/w), specificheatcapacity (j/m^3k)

# ── Material -> Solid library mappings (one per Label used in the floorplans) ──
[GPU_Si]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[GPU_FEOL]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[GPU_BEOL]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[UBUMP]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[DRAM_Si]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[THERMAL_SI]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[DAF]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[Solid]
properties = thermalresistivity ((m-k)/w), specificheatcapacity (j/m^3k)
