[DEFAULT]
label =

# ─────────────────────────────────────────────────────────────────────────────
# Material thermal properties for the 3D HBM-on-GPU stack.
# Convention: thermalresistivity ((m-k)/w) = 1 / k(W/m-K).
# (Steady-state results depend only on thermalresistivity; capacitance is for
#  transient runs.)
# ─────────────────────────────────────────────────────────────────────────────

[GPU_Si]
# GPU substrate / bulk silicon with TSVs.  k = 130 W/(m-K)
thermalresistivity ((m-k)/w) = 0.00769
specificheatcapacity (j/m^3k) = 1750000

[GPU_FEOL]
# GPU active silicon (the dominant 414 W heat source).  k = 110 W/(m-K)
thermalresistivity ((m-k)/w) = 0.00909
specificheatcapacity (j/m^3k) = 1700000

[GPU_BEOL]
# GPU Cu / low-k interconnect stack.  k_eff = 12 W/(m-K)
thermalresistivity ((m-k)/w) = 0.0833
specificheatcapacity (j/m^3k) = 2400000

[UBUMP]
# GPU<->HBM hybrid-bond / microbump + underfill 3D interface.  k_eff = 20 W/(m-K)
thermalresistivity ((m-k)/w) = 0.05
specificheatcapacity (j/m^3k) = 2500000

[DRAM_Si]
# Thinned HBM DRAM die (Si + thin BEOL + inter-die bond), with TSVs.
# k_eff = 100 W/(m-K)
thermalresistivity ((m-k)/w) = 0.01
specificheatcapacity (j/m^3k) = 1750000

[THERMAL_SI]
# "Thermal silicon" filler block: high-conductivity Si providing vertical
# heat-escape paths in the cross/frame between HBM stacks.  k = 140 W/(m-K)
thermalresistivity ((m-k)/w) = 0.007143
specificheatcapacity (j/m^3k) = 1750000

[DAF]
# Die-attach film / inter-die bond layer between stacked HBM DRAM dies.
# This low-k adhesive is the DOMINANT vertical thermal resistance in an HBM
# stack -- the "thermal bottleneck" the paper targets.  k = 0.8 W/(m-K).
# (Only present under the HBM macros; the thermal-silicon cross/frame stays
#  high-k so heat funnels to those vertical escape paths.)
thermalresistivity ((m-k)/w) = 1.25
specificheatcapacity (j/m^3k) = 1500000

[Init]
# Paper ambient = 20 C = 293.15 K.
ambient = 293.15 K
temperature = 293.15 K

# ─────────────────────────────────────────────────────────────────────────────
# Top-side cooling = liquid cold plate ("lid").  Modelled as a pure convective
# (HTC) boundary: r_amb = 1/(htc * cell_area).  Paper lid HTC = 30,000 W/m^2K.
# (Lid-doubled scenario uses experiment_lid60k.config with htc = 60000.)
#
# NOTE: PACT cools only from this top package; the bottom (laminate, paper HTC
# 200 W/m^2K) is adiabatic here. That matches the lid-dominated regime, but the
# laminate-enhanced STCO sweep (200->5000) cannot be distinguished without a
# bottom-side boundary.
# ─────────────────────────────────────────────────────────────────────────────
[NoPackage]
htc = 30000
thickness (m) = 1e-6
thermalresistivity ((m-k)/w) = 0.00769
specificheatcapacity (j/m^3k) = 1750000
