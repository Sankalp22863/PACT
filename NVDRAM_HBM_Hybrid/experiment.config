[DEFAULT]
label =

# ─────────────────────────────────────────────────────────────────────────────
# Material thermal properties for the hybrid NVDRAM-bottom / DRAM-top 3D stack.
# Convention: thermalresistivity ((m-k)/w) = 1 / k(W/m-K).
# (Steady-state results depend only on thermalresistivity; capacitance is for
#  transient runs.) Values merged from NVDRAM_Stacked + DRAM_3D_Stacked.
# ─────────────────────────────────────────────────────────────────────────────

[GPU_Si]
# GPU substrate / bulk silicon with TSVs.  k = 130 W/(m-K)
thermalresistivity ((m-k)/w) = 0.00769
specificheatcapacity (j/m^3k) = 1750000

[GPU_FEOL]
# GPU active silicon (the dominant heat source).  k = 110 W/(m-K)
thermalresistivity ((m-k)/w) = 0.00909
specificheatcapacity (j/m^3k) = 1700000

[GPU_BEOL]
# GPU Cu / low-k interconnect stack.  k_eff = 12 W/(m-K)
thermalresistivity ((m-k)/w) = 0.0833
specificheatcapacity (j/m^3k) = 2400000

[UBUMP]
# GPU<->memory hybrid-bond / microbump + underfill 3D interface.  k_eff = 20 W/(m-K)
thermalresistivity ((m-k)/w) = 0.05
specificheatcapacity (j/m^3k) = 2500000

[NV_FEOL]
# NVDRAM die: poly-Si 1T1C access transistor + HZO ferroelectric cap + thin BEOL.
# k_eff set EQUAL to the DRAM die (DRAM_Si) per request: k = 100 W/(m-K).
# (Original ferroelectric-NVDRAM value was k ~ 14 W/(m-K), i.e.
#  thermalresistivity = 0.07; restore that to model the low-k NVDRAM again.)
thermalresistivity ((m-k)/w) = 0.01
specificheatcapacity (j/m^3k) = 1500000

[NV_BEOL]
# NVDRAM back-end-of-line: local word/bit-line Cu interconnect.  k_eff ~ 12 W/(m-K)
thermalresistivity ((m-k)/w) = 0.0833
specificheatcapacity (j/m^3k) = 2200000

[DRAM_Si]
# Thinned HBM DRAM die (Si + thin BEOL + inter-die bond), with TSVs.  k_eff = 100 W/(m-K)
thermalresistivity ((m-k)/w) = 0.01
specificheatcapacity (j/m^3k) = 1750000

[THERMAL_SI]
# "Thermal silicon" filler block: high-conductivity Si providing vertical
# heat-escape paths in the cross/frame between memory stacks.  k = 140 W/(m-K)
thermalresistivity ((m-k)/w) = 0.007143
specificheatcapacity (j/m^3k) = 1750000

[DAF]
# Die-attach film / inter-die bond layer between stacked dies. This low-k
# adhesive is the DOMINANT vertical thermal resistance -- the "thermal
# bottleneck" the paper targets.  k = 0.8 W/(m-K).
thermalresistivity ((m-k)/w) = 1.25
specificheatcapacity (j/m^3k) = 1500000

[Init]
# Paper ambient = 20 C = 293.15 K.
ambient = 293.15 K
temperature = 293.15 K

# ─────────────────────────────────────────────────────────────────────────────
# Top-side cooling = liquid cold plate ("lid"). Modelled as a pure convective
# (HTC) boundary: r_amb = 1/(htc * cell_area). Paper lid HTC = 30,000 W/m^2K.
# PACT cools only from this top package; the bottom (laminate) is adiabatic.
# ─────────────────────────────────────────────────────────────────────────────
[NoPackage]
htc = 30000
thickness (m) = 1e-6
thermalresistivity ((m-k)/w) = 0.00769
specificheatcapacity (j/m^3k) = 1750000
