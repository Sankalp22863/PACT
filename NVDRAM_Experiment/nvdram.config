[DEFAULT]
label =

[Si]
# Bulk silicon for CMOS Under Array substrate
# k = 130 W/(m-K) -> thermalresistivity = 1/130
thermalresistivity ((m-k)/w) = 0.0077
specificheatcapacity (j/m^3k) = 1750000

[PolySi1T1C]
# Poly-Si dominant 1T1C memory layer (poly-Si + HZO + SiO2)
# Poly-Si grain size at LPCVD conditions: k_eff ~ 14 W/(m-K)
# HZO (k~1.5) and gate oxide (k~1.4) reduce effective TC
# -> thermalresistivity = 1/14 ~ 0.07 (m-K)/W
# Specific heat capacity weighted average of poly-Si (~1.63e6) and oxides (~1.6e6)
thermalresistivity ((m-k)/w) = 0.07
specificheatcapacity (j/m^3k) = 1500000

[Init]
# Ambient and initial temperature
ambient = 318.15 K
temperature = 273.15 K

[HeatSink]
# Medium-cost heat sink (HotSpot model) for 8.5mm x 8.5mm NVDRAM die
# Heatspreader sized to die; heatsink sized to package
convection_cap (j/k) = 140.4
convection_r (k/w) = 0.1
heatsink_side (m) = 0.04
heatsink_thickness (m) = 0.001
heatsink_thermalconductivity (w/(m-k)) = 400.0
heatsink_specificheatcapacity (j/m^3k) = 3.55e6
heatspreader_side (m) = 0.02
heatspreader_thickness (m) = 0.001
heatspreader_thermalconductivity (w/(m-k)) = 400.0
heatspreader_specificheatcapacity (j/m^3k) = 3.55e6
